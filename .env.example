# PrinterIQ environment variables — copy to .env and fill in real values
# Never commit .env — it is in .gitignore

# ── Supabase ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tenant ───────────────────────────────────────────────────────────────────
# Set to the UUID of the tenants row after running 0001_init.sql
TENANT_ID=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Instantly ────────────────────────────────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID=

# ── ClickSend ────────────────────────────────────────────────────────────────
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@printeriq.com

# ── Escalation ───────────────────────────────────────────────────────────────
ESCALATION_PHONE=+61400000000

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_URL=https://dashboard.printeriq.com
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
