# PrinterIQ production environment variables
# Copy to .env on the VPS or configure as GitHub/VPS secrets.
# Never commit real secret values.

# -- Supabase ---------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- Tenant -----------------------------------------------------------------
TENANT_ID=10000000-0000-0000-0000-000000000001

# -- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# -- Instantly --------------------------------------------------------------
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=instantly_campaign_placeholder
INSTANTLY_WEBHOOK_ID_REPLY=
INSTANTLY_WEBHOOK_ID_BOUNCED=
INSTANTLY_WEBHOOK_ID_UNSUBBED=

# -- Stripe -----------------------------------------------------------------
# Issue #10 should select the active key set from STRIPE_MODE.
STRIPE_MODE=live
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID=prod_test_placeholder
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID=prod_live_placeholder

# -- SMS --------------------------------------------------------------------
# PRD target provider is ClickSend. Keep Twilio placeholders only if the project
# intentionally continues with Twilio in implementation.
CLICKSEND_USERNAME=clicksend_username_placeholder
CLICKSEND_API_KEY=
TWILIO_ACCOUNT_SID=AC_live_placeholder
TWILIO_AUTH_TOKEN=

# -- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@presciaiq.com

# -- Escalation -------------------------------------------------------------
ESCALATION_PHONE=+61400000000

# -- Dashboard --------------------------------------------------------------
DASHBOARD_URL=https://dashboard.presciaiq.com
DASHBOARD_MAX_CSV_UPLOAD_BYTES=52428800
PREVIEW_BASE_URL=https://preview.presciaiq.com
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_DASHBOARD_MAX_CSV_UPLOAD_MB=50

# -- Runtime ----------------------------------------------------------------
NODE_ENV=production
