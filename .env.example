# PrinterIQ production environment variables
# Copy to .env on the VPS or configure as GitHub/VPS secrets.
# Never commit real secret values.

# -- Supabase ---------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- Tenant -----------------------------------------------------------------
TENANT_ID=10000000-0000-0000-0000-000000000001

# -- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# -- Instantly --------------------------------------------------------------
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=instantly_campaign_placeholder
INSTANTLY_WEBHOOK_SECRET=

# -- Stripe -----------------------------------------------------------------
# Use live keys only in production. Use .env.test.example for test-mode values.
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=prod_live_placeholder

# -- SMS --------------------------------------------------------------------
# PRD target provider is ClickSend. Keep Twilio placeholders only if the project
# intentionally continues with Twilio in implementation.
CLICKSEND_USERNAME=clicksend_username_placeholder
CLICKSEND_API_KEY=
TWILIO_ACCOUNT_SID=AC_live_placeholder
TWILIO_AUTH_TOKEN=

# -- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@printeriq.com

# -- Escalation -------------------------------------------------------------
ESCALATION_PHONE=+61400000000

# -- Dashboard --------------------------------------------------------------
DASHBOARD_URL=https://dashboard.printeriq.com
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# -- Runtime ----------------------------------------------------------------
NODE_ENV=production
