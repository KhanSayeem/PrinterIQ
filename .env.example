# PrinterIQ production environment variables
# Copy to .env on the VPS or configure as GitHub/VPS secrets.
# Never commit real secret values.

# -- Supabase ---------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- Tenant -----------------------------------------------------------------
TENANT_ID=10000000-0000-0000-0000-000000000001

# -- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# The live VPS value is 35, not 40. This example was stale.
# NOTE: 35 was calibrated against qualify-v1, whose rubric rewarded trades and
# penalised everything else. qualify-v2 scores different things, so the same
# integer no longer means the same thing. Recalibrate with
# `python -m workers.shadow_qualify` before trusting this number.
QUALIFICATION_SCORE_THRESHOLD=35

# -- Instantly --------------------------------------------------------------
# INSTANTLY_API_KEY, INSTANTLY_CAMPAIGN_ID and INSTANTLY_NO_WEBSITE_CAMPAIGN_ID
# are also read by the dashboard, from services/dashboard/.env.production, for
# the /sending emergency stop. A campaign id the dashboard cannot see is a
# campaign that button cannot pause.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=instantly_campaign_placeholder
# Leads with no website at all. Their opening line cannot mention a site, and
# the Step 1 template in INSTANTLY_CAMPAIGN_ID does. Leave this unset and
# those leads fall back to the campaign above, which will email them about a
# website they do not have.
INSTANTLY_NO_WEBSITE_CAMPAIGN_ID=
INSTANTLY_WEBHOOK_AUTH_REPLY=
INSTANTLY_WEBHOOK_AUTH_BOUNCED=
INSTANTLY_WEBHOOK_AUTH_UNSUBBED=
INSTANTLY_PAUSED_LIST_ID=

# -- Prospect discovery -----------------------------------------------------
OUTSCRAPER_API_KEY=
APOLLO_API_KEY=
PROSPECT_DISCOVERY_TOTAL_LIMIT=500
PROSPECT_DISCOVERY_POLL_SECONDS=30
PROSPECT_RAW_RETENTION_DAYS=30
PROSPECT_RECORD_RETENTION_DAYS=90

# -- Stripe -----------------------------------------------------------------
# Issue #10 should select the active key set from STRIPE_MODE.
STRIPE_MODE=live
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID=prod_test_placeholder
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID=prod_live_placeholder

# -- SMS --------------------------------------------------------------------
# PRD target provider is ClickSend. Keep Twilio placeholders only if the project
# intentionally continues with Twilio in implementation.
CLICKSEND_USERNAME=clicksend_username_placeholder
CLICKSEND_API_KEY=
TWILIO_ACCOUNT_SID=AC_live_placeholder
TWILIO_AUTH_TOKEN=

# -- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@presciaiq.com

# -- Escalation -------------------------------------------------------------
ESCALATION_PHONE=+61400000000

# -- Dashboard --------------------------------------------------------------
DASHBOARD_URL=https://dashboard.presciaiq.com
DASHBOARD_MAX_CSV_UPLOAD_BYTES=52428800
PREVIEW_BASE_URL=https://preview.presciaiq.com
# Shared secret between the nginx mirror on preview.presciaiq.com and the
# reply-agent route that records preview views. Must match the value in
# /etc/nginx/snippets/preview-view-secret.conf. Generate with
# `openssl rand -hex 32`. Unset means view tracking stays off.
PREVIEW_VIEW_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
NEXT_PUBLIC_DASHBOARD_MAX_CSV_UPLOAD_MB=50

# -- Runtime ----------------------------------------------------------------
NODE_ENV=production
