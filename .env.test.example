# PrinterIQ test/local environment overrides
# Copy to .env.test and add provider credentials from .env.example locally.
# Never commit real secret values.

# -- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://[test-project-ref].supabase.co

# -- Tenant -----------------------------------------------------------------
TENANT_ID=10000000-0000-0000-0000-000000000001

# -- Redis ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -- Instantly --------------------------------------------------------------
INSTANTLY_CAMPAIGN_ID=instantly_test_campaign_placeholder
INSTANTLY_WEBHOOK_ID_REPLY=reply_test_webhook_id
INSTANTLY_WEBHOOK_ID_BOUNCED=bounced_test_webhook_id
INSTANTLY_WEBHOOK_ID_UNSUBBED=unsubbed_test_webhook_id

# -- Stripe -----------------------------------------------------------------
# Issue #10 should select the active key set from STRIPE_MODE.
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRODUCT_ID=prod_test_placeholder
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRODUCT_ID=prod_live_placeholder

# -- Resend -----------------------------------------------------------------
RESEND_FROM_EMAIL=no-reply@presciaiq.com

# -- Escalation -------------------------------------------------------------
ESCALATION_PHONE=+61400000000

# -- Dashboard --------------------------------------------------------------
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://[test-project-ref].supabase.co

# -- Runtime ----------------------------------------------------------------
NODE_ENV=test
